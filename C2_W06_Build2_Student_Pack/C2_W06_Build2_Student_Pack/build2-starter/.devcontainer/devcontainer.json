{
  // The Codespace this repository opens in: Python 3.12 with the Python and Jupyter extensions,
  // and every package in requirements.txt installed once, when the Codespace is created.
  "name": "Hotel cancellations, Build 2",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt && python src/data.py",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  }
}
